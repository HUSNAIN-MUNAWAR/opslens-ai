# OpsLens AI Phase 3 environment example
# Use development + SQLite for deterministic local demos only.
ENVIRONMENT=development
DEMO_MODE=true
DATABASE_URL=sqlite+pysqlite:///./opslens.db
JWT_SECRET=change-this-local-secret-at-least-32-characters
CORS_ORIGINS=http://localhost:3000
REQUEST_RATE_LIMIT=120
SQL_ROW_LIMIT=500
SQL_TIMEOUT_MS=5000
SQL_COMPLEXITY_LIMIT=14
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Production guidance:
# ENVIRONMENT=production
# DEMO_MODE=false
# DATABASE_URL=postgresql+psycopg://user:password@postgres:5432/opslens
# JWT_SECRET=<strong-secret-from-secret-manager>
# CORS_ORIGINS=https://your-opslens-domain.example
# Configure managed PostgreSQL, Redis, TLS, trusted origins, backups, and read-only AI DB role.
